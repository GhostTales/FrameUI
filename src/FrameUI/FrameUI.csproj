<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>FrameUI</AssemblyName>
    <RootNamespace>FrameUI</RootNamespace>
    <Description>Figma-style frame UI for the stripped IMGUI of Hell Clock</Description>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-only: BepInEx provides Harmony at runtime. -->
    <PackageReference Include="HarmonyX" Version="2.10.2" PrivateAssets="all" ExcludeAssets="runtime" />
    <InternalsVisibleTo Include="FrameUI.Tests" />
  </ItemGroup>

</Project>
